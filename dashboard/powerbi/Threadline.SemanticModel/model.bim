          },
          {
            "name": "is_observable",
            "dataType": "boolean",
            "sourceColumn": "is_observable",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Retention %",
            "expression": "DIVIDE(SUM(cohort_retention[active_customers]), SUM(cohort_retention[cohort_size]))",
            "formatString": "0.0%",
            "displayFolder": "Cohorts",
            "description": "% of cohort placing a valid order in month k (observable months only)."
          },
          {
            "name": "Cohort Customers",
            "expression": "SUM(cohort_retention[cohort_size])",
            "formatString": "#,0",
            "displayFolder": "Cohorts"
          }
        ],
        "partitions": [
          {
            "name": "cohort_retention",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(ExportFolder & \"cohort_retention.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"cohort_month\", type date}, {\"acquisition_channel\", type text}, {\"month_offset\", Int64.Type}, {\"cohort_size\", Int64.Type}, {\"active_customers\", Int64.Type}, {\"orders\", Int64.Type}, {\"net_revenue\", type number}, {\"gross_margin\", type number}, {\"retention_rate\", type number}, {\"is_observable\", type logical}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
