          },
          {
            "name": "net_revenue_365d",
            "dataType": "double",
            "sourceColumn": "net_revenue_365d",
            "summarizeBy": "sum"
          },
          {
            "name": "orders_365d",
            "dataType": "int64",
            "sourceColumn": "orders_365d",
            "summarizeBy": "none"
          },
          {
            "name": "margin_to_date",
            "dataType": "double",
            "sourceColumn": "margin_to_date",
            "summarizeBy": "sum"
          },
          {
            "name": "orders_to_date",
            "dataType": "int64",
            "sourceColumn": "orders_to_date",
            "summarizeBy": "none"
          },
          {
            "name": "eligible_90d",
            "dataType": "boolean",
            "sourceColumn": "eligible_90d",
            "summarizeBy": "none"
          },
          {
            "name": "eligible_180d",
            "dataType": "boolean",
            "sourceColumn": "eligible_180d",
            "summarizeBy": "none"
          },
          {
            "name": "eligible_365d",
            "dataType": "boolean",
            "sourceColumn": "eligible_365d",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "LTV 12m Margin",
            "expression": "CALCULATE(AVERAGE(customer_ltv[margin_365d]), customer_ltv[eligible_365d] = TRUE())",
            "formatString": "\"₹\"#,0",
            "displayFolder": "LTV",
            "description": "Avg gross margin within 365 days of first order; customers with a complete 365+30 day window only."
          },
          {
            "name": "LTV 90d Margin",
            "expression": "CALCULATE(AVERAGE(customer_ltv[margin_90d]), customer_ltv[eligible_90d] = TRUE())",
            "formatString": "\"₹\"#,0",
            "displayFolder": "LTV"
          },
          {
            "name": "First Order Margin",
            "expression": "AVERAGE(customer_ltv[margin_first_order])",
            "formatString": "\"₹\"#,0",
            "displayFolder": "LTV"
          },
          {
            "name": "Repeat Rate 12m",
            "expression": "DIVIDE(CALCULATE(COUNTROWS(customer_ltv), customer_ltv[eligible_365d] = TRUE(), customer_ltv[orders_365d] >= 2), CALCULATE(COUNTROWS(customer_ltv), customer_ltv[eligible_365d] = TRUE()))",
            "formatString": "0.0%",
            "displayFolder": "LTV"
          },
          {
            "name": "Customers (LTV)",
            "expression": "COUNTROWS(customer_ltv)",
            "formatString": "#,0",
            "displayFolder": "LTV"
          },
          {
            "name": "Historical Margin per Customer",
            "expression": "AVERAGE(customer_ltv[margin_to_date])",
            "formatString": "\"₹\"#,0",
            "displayFolder": "LTV"
          }
        ],
        "partitions": [
          {
            "name": "customer_ltv",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
